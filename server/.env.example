PORT=3001
# Allowed browser origins for CORS (Next app URLs). Omit both to default to localhost + 127.0.0.1 on port 3000.
# CLIENT_ORIGIN=http://localhost:3000
# CLIENT_ORIGINS=https://my-app.com,http://localhost:3000

# --- Firebase / Google Cloud Storage (optional). If FIREBASE_STORAGE_BUCKET or GCS_BUCKET_NAME is set,
# packaged HLS uploads to the bucket + job list stays in JOB_REGISTRY_PATH (defaults under SERVER_DATA_ROOT / server/.data).

# Job list JSON. Default: <SERVER_DATA_ROOT>/jobs-registry.json. Docker Compose often uses /data/jobs-registry.json.
# JOB_REGISTRY_PATH=/data/jobs-registry.json

# Default Firebase Storage bucket (often my-project-id.appspot.com)
# FIREBASE_STORAGE_BUCKET=my-project.appspot.com
# GCS_BUCKET_NAME=my-project.appspot.com

# Object prefix inside bucket (no leading/trailing slash)
# STORAGE_HLS_PREFIX=hls-packaging

# Local writable root (staging uploads, workspaces, registry default). Overrides default server/.data
# SERVER_DATA_ROOT=/absolute/path/to/writable-root

# --- Client playback URLs (Firebase / GCS packaging only) ---
# Default derives Firebase REST URLs → https://firebasestorage.googleapis.com/v0/b/<bucket>/o/<encodeURIComponent(path)>?alt=media
# Playlists are rewritten to absolute Firebase URIs before upload (relative #EXT-X URIs do not resolve correctly on that host).
# Set gcs for classic path URLs:
# HLS_PUBLIC_URL_STYLE=gcs

# Append ?token= on Firebase REST URLs and set object metadata firebaseStorageDownloadTokens (default on). Disable for rules-only public buckets:
# HLS_FIREBASE_PLAYBACK_TOKEN=0

# Explicit base overrides auto-derivation (no trailing slash).
# HLS_PUBLIC_BASE_URL=https://storage.googleapis.com/YOUR_BUCKET/hls-packaging

# Turn OFF auto derivation (stay on GET /hls proxy unless HLS_PUBLIC_BASE_URL is set):
# HLS_PUBLIC_FROM_BUCKET=0

# Force proxy-only playback (omit manifestPublicUrl — private buckets OK, heavier API load):
# HLS_PROXY_PLAYBACK_ONLY=1
# If GET https://storage.googleapis.com/<bucket>/.../master.m3u8 returns 403 from the browser, either set
# HLS_PROXY_PLAYBACK_ONLY=1 or open read + CORS on the bucket (Firebase Storage Rules + gsutil cors). README: "403 Forbidden on direct".

# Parallel GCS uploads per job (default 8). Lower if Docker hits quota or memory pressure.
# GCS_UPLOAD_CONCURRENCY=4

# [hls delivery] logs: manifests (default) logs only .m3u8 pulls; all = every TS segment too; off = none
# HLS_LOG_DELIVERY=all
# (alias) HLS_LOG_ALL_HLS=1

# Auth (pick one):

# Full service account JSON (single line — or use GCP_SERVICE_ACCOUNT_JSON_B64 below)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Base64-encoded service account JSON (good for Compose / CI without multiline havoc)
# GCP_SERVICE_ACCOUNT_JSON_B64=

# Classic split fields from Firebase Console (private key must retain \n or real newlines in .env)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Or point to a downloaded key file path (local dev / some hosts)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
